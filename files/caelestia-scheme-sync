#!/usr/bin/env python3
"""Two-way link between Caelestia schemes and wallpapers, plus live app reloads.

Layout: ~/Pictures/Wallpapers/<scheme>/<flavour>-<mode>/<image>
        e.g. catppuccin/mocha-dark/lake.jpg, gruvbox/medium-light/forest.jpg

  from-wallpaper  (Caelestia wallpaper postHook)
      Wallpaper inside a scheme folder -> switch to that scheme/flavour/mode
      Wallpaper anywhere else          -> 'dynamic' (colours from the image)
  from-scheme     (systemd path unit on scheme.json)
      Current wallpaper isn't in the scheme's folder -> random one from it
  apps            (Caelestia theme postHook, after all app colours are written)
      Spotify: re-inject Spicetify colours and reload its UI (playback continues)
      (Vesktop and LibreWolf pick up colour changes live by themselves)

from-* calls are no-ops when things already match, so they never loop.
"""
import fcntl
import json
import os
import random
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
STATE = Path(os.getenv("XDG_STATE_HOME", HOME / ".local/state")) / "caelestia"
PICS = Path(os.getenv("XDG_PICTURES_DIR", HOME / "Pictures"))
WALLS = Path(os.getenv("CAELESTIA_WALLPAPERS_DIR", PICS / "Wallpapers"))
IMG = {".png", ".jpg", ".jpeg", ".webp", ".gif"}
RUN = Path(f"/run/user/{os.getuid()}")


def caelestia(*args):
    # Mark nested calls so the from-* hooks they trigger return immediately (no deadlock / loops).
    env = {**os.environ, "CAELESTIA_SYNC_ACTIVE": "1"}
    subprocess.run(["caelestia", *args], check=False, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def valid(scheme, flavour, mode):
    try:
        from caelestia.utils.scheme import get_scheme_flavours, get_scheme_modes, get_scheme_names
        return scheme in get_scheme_names() and flavour in get_scheme_flavours(scheme) \
            and mode in get_scheme_modes(scheme, flavour)
    except Exception:
        return False


def current():
    try:
        s = json.loads((STATE / "scheme.json").read_text())
        return s.get("name"), s.get("flavour"), s.get("mode")
    except (OSError, ValueError):
        return None, None, None


def current_wallpaper():
    try:
        return Path((STATE / "wallpaper/path.txt").read_text().strip())
    except OSError:
        return None


def folder_of(wall):
    """(scheme, flavour, mode) for a wallpaper inside WALLS/<scheme>/<flavour>-<mode>/, else None."""
    try:
        rel = wall.resolve().relative_to(WALLS.resolve())
    except ValueError:
        return None
    if len(rel.parts) < 3 or "-" not in rel.parts[1]:
        return None
    flavour, mode = rel.parts[1].rsplit("-", 1)
    return rel.parts[0], flavour, mode


def from_wallpaper():
    wall = Path(os.environ["WALLPAPER_PATH"]) if os.environ.get("WALLPAPER_PATH") else current_wallpaper()
    if not wall:
        return
    target = folder_of(wall)
    if target and valid(*target):
        if current() != target:
            name, flavour, mode = target
            caelestia("scheme", "set", "-n", name, "-f", flavour, "-m", mode)
    elif current()[0] != "dynamic":
        caelestia("scheme", "set", "-n", "dynamic")


def from_scheme():
    name, flavour, mode = current()
    if not name or name == "dynamic":
        return
    wall = current_wallpaper()
    if wall and wall.is_file() and folder_of(wall) == (name, flavour, mode):
        return
    # Exact flavour+mode first, then the same flavour in the other mode, then anything in the scheme.
    for pattern in (f"{flavour}-{mode}", f"{flavour}-*", "*"):
        choices = [p for d in (WALLS / name).glob(pattern) if d.is_dir()
                   for p in d.rglob("*") if p.suffix.lower() in IMG and p != wall]
        if choices:
            caelestia("wallpaper", "-f", str(random.choice(choices)))
            return


def apps():
    # Spotify: only if running, and only when Spicetify is set up for it.
    if subprocess.run(["pgrep", "-x", "spotify"], capture_output=True).returncode != 0 or not shutil.which("spicetify"):
        return
    # Debounce: rapid scheme flicking only reloads Spotify once.
    with open(RUN / "caelestia-apps.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        subprocess.run(["spicetify", "-q", "refresh"], check=False, capture_output=True)
        subprocess.run(["hyprctl", "dispatch",
                        'hl.dsp.send_shortcut({ mods = "CTRL SHIFT", key = "R", window = "class:^(Spotify)$" })'],
                       check=False, capture_output=True)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "apps":
        return apps()
    if os.environ.get("CAELESTIA_SYNC_ACTIVE"):
        return
    with open(RUN / "caelestia-scheme-sync.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        {"from-wallpaper": from_wallpaper, "from-scheme": from_scheme}[cmd]()


if __name__ == "__main__":
    main()
